---
---

<main id="main-content" class="dgs-404-page">
  <section class="dgs-404-hero" aria-labelledby="error-title">
    <div class="dgs-404-hero__inner">
      <p class="dgs-404-eyebrow">Page not found</p>
      <div class="dgs-404-grid">
        <p class="dgs-404-code" aria-hidden="true">404</p>
        <div class="dgs-404-copy">
          <h1 id="error-title">This page has moved.</h1>
          <p>We could not find the page you requested. It may have a new address, or the link may be out of date.</p>
          <a class="dgs-404-link" href="/">Return to the homepage</a>
        </div>
      </div>
    </div>
  </section>
</main>

<style>
  .dgs-404-page {
    min-height: 68vh;
    background: #f5f8fc;
    color: #0a2240;
  }

  .dgs-404-hero {
    padding: clamp(64px, 9vw, 112px) 24px clamp(72px, 10vw, 128px);
    background:
      radial-gradient(circle at 85% 5%, rgba(255, 255, 255, 0.13), transparent 34%),
      #0a2240;
    color: #ffffff;
  }

  .dgs-404-hero__inner {
    width: min(100%, 1200px);
    margin: 0 auto;
  }

  .dgs-404-eyebrow {
    margin: 0 0 28px;
    font-family: 'Public Sans Variable', 'Public Sans', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #b9d3f2;
  }

  .dgs-404-grid {
    display: grid;
    grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(44px, 8vw, 112px);
    align-items: center;
  }

  .dgs-404-code {
    margin: 0;
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: clamp(128px, 19vw, 250px);
    font-weight: 400;
    line-height: 0.72;
    letter-spacing: -0.065em;
    color: #ffffff;
  }

  .dgs-404-copy {
    padding-left: clamp(28px, 4vw, 54px);
    border-left: 1px solid rgba(255, 255, 255, 0.25);
  }

  .dgs-404-copy h1 {
    max-width: 720px;
    margin: 0;
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: clamp(48px, 7vw, 82px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: #ffffff;
  }

  .dgs-404-copy p {
    max-width: 680px;
    margin: 26px 0 0;
    color: #d7e2ee;
    font-family: 'Public Sans Variable', 'Public Sans', system-ui, sans-serif;
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.7;
  }

  .dgs-404-link {
    margin-top: 34px;
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    border: 2px solid #ffffff;
    background: #ffffff;
    color: #0a2240;
    font-family: 'Public Sans Variable', 'Public Sans', system-ui, sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .dgs-404-link:hover,
  .dgs-404-link:focus-visible {
    background: transparent;
    color: #ffffff;
  }

  .dgs-404-link:focus-visible {
    outline: 3px solid #b9d3f2;
    outline-offset: 4px;
  }

  @media (max-width: 760px) {
    .dgs-404-hero {
      padding-inline: 18px;
    }

    .dgs-404-grid {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .dgs-404-code {
      font-size: clamp(112px, 38vw, 180px);
    }

    .dgs-404-copy {
      padding: 34px 0 0;
      border-top: 1px solid rgba(255, 255, 255, 0.25);
      border-left: 0;
    }
  }

  @media (max-width: 420px) {
    .dgs-404-link {
      box-sizing: border-box;
      width: 100%;
      padding-inline: 16px;
      text-align: center;
    }
  }
</style>
