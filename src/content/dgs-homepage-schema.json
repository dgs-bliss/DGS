  {
   "@type": "FAQPage",
   "@id": "https://www.digitalgrowthsociety.org/#faq",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "When and where do you meet?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Every Friday at 8:30 a.m. Pacific (11:30 a.m. Eastern), on Zoom."
     }
    },
    {
     "@type": "Question",
     "name": "What does a guest session look like?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "We start with a quick round of introductions, about 10 to 15 minutes. Then the floor is yours for 30 minutes or so. The last 20 to 30 minutes are open discussion and your hot seat."
     }
    },
    {
     "@type": "Question",
     "name": "Do I need a polished presentation?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No. This isn’t a conference stage, and it’s pretty informal. Bring the knowledge you’d share in a room of trusted peers but wouldn’t put in front of a hundred people: a test, a workflow, a tool. Slides are optional."
     }
    },
    {
     "@type": "Question",
     "name": "Can I share something I’m building?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. Guests often beta-launch or beta-test their products with us. It’s a highly technical room, so expect sharp questions and ideas you can use."
     }
    },
    {
     "@type": "Question",
     "name": "Does it cost anything to present?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No. Presenting is free."
     }
    },
    {
     "@type": "Question",
     "name": "What happens after I apply?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "We read every application and you’ll hear back from us within a few days."
     }
    },
    {
     "@type": "Question",
     "name": "Will my session be shared?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No. Sessions are recorded for members only. Everything said at the table is confidential and is never published, posted or passed on."
     }
    },
    {
     "@type": "Question",
     "name": "How do I join the Dozen?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "You don’t apply to join. Guests present first and join our Master Council. When a seat opens, the current members vote in a new member from the Council."
     }
    }
   ],
