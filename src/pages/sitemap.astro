---
import Base from '../layouts/Base.astro';
import { buildPublishedPageList } from '../lib/published-pages.mjs';

const routeFiles = import.meta.glob('./**/*.{astro,md,mdx}', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const publishedPages = buildPublishedPageList(Object.keys(routeFiles));
const title = 'Sitemap | Digital Growth Society';
const description = 'Browse all published public pages on the Digital Growth Society website.';
---

<Base title={title} description={description}>
  <main id="main-content" class="dgs-sitemap-page">
    <header class="dgs-sitemap-hero">
      <div class="dgs-sitemap-hero__inner">
        <a class="dgs-sitemap-back" href="/">← Back to Digital Growth Society</a>
        <p class="dgs-sitemap-eyebrow">Website directory</p>
        <h1>Sitemap</h1>
        <p>Every published public page, collected automatically when the site is built.</p>
      </div>
    </header>

    <section class="dgs-sitemap-content" data-sitemap-content aria-labelledby="sitemap-pages-title">
      <div class="dgs-sitemap-heading">
        <div>
          <p class="dgs-sitemap-kicker">Published pages</p>
          <h2 id="sitemap-pages-title">Explore the site</h2>
        </div>
        <span aria-label={`${publishedPages.length} published pages`}>{publishedPages.length} pages</span>
      </div>
      <ul>
        {publishedPages.map((page) => (
          <li>
            <a href={page.href}>
              <span>{page.title}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>

<style>
  .dgs-sitemap-page {
    min-height: 70vh;
    background: #f5f8fc;
    color: #0a2240;
  }

  .dgs-sitemap-hero {
    padding: clamp(64px, 8vw, 108px) 24px clamp(50px, 6vw, 76px);
    background:
      radial-gradient(circle at 85% 5%, rgba(255, 255, 255, 0.13), transparent 34%),
      #0a2240;
    color: #ffffff;
  }

  .dgs-sitemap-hero__inner,
  .dgs-sitemap-content {
    width: min(100%, 920px);
    margin: 0 auto;
  }

  .dgs-sitemap-back {
    display: inline-flex;
    margin-bottom: 48px;
    color: #ffffff;
    font-family: 'Public Sans Variable', 'Public Sans', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .dgs-sitemap-back:hover,
  .dgs-sitemap-back:focus-visible {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .dgs-sitemap-back:focus-visible,
  .dgs-sitemap-content a:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 5px;
  }

  .dgs-sitemap-eyebrow,
  .dgs-sitemap-kicker {
    margin: 0 0 16px;
    font-family: 'Public Sans Variable', 'Public Sans', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .dgs-sitemap-eyebrow {
    color: #b9d3f2;
  }

  .dgs-sitemap-kicker {
    color: #1f4e8c;
  }

  .dgs-sitemap-hero h1 {
    margin: 0;
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: clamp(46px, 8vw, 82px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: #ffffff;
  }

  .dgs-sitemap-hero__inner > p:last-child {
    max-width: 720px;
    margin: 26px 0 0;
    color: #d7e2ee;
    font-family: 'Public Sans Variable', 'Public Sans', system-ui, sans-serif;
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.7;
  }

  .dgs-sitemap-content {
    box-sizing: border-box;
    margin-top: clamp(32px, 5vw, 58px);
    margin-bottom: clamp(64px, 9vw, 112px);
    padding: clamp(30px, 5vw, 62px);
    border: 1px solid #dadfe3;
    background: #ffffff;
    box-shadow: 0 24px 70px rgba(10, 34, 64, 0.08);
  }

  .dgs-sitemap-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    padding-bottom: 28px;
    border-bottom: 1px solid #dadfe3;
  }

  .dgs-sitemap-heading h2 {
    margin: 0;
    font-family: 'Newsreader Variable', 'Newsreader', Georgia, serif;
    font-size: clamp(34px, 5vw, 50px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .dgs-sitemap-heading > span {
    flex: none;
    color: #5a6474;
    font-family: 'Public Sans Variable', 'Public Sans', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 700;
  }

  .dgs-sitemap-content ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dgs-sitemap-content li {
    border-bottom: 1px solid #dadfe3;
  }

  .dgs-sitemap-content a {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    color: #0a2240;
    font-family: 'Public Sans Variable', 'Public Sans', system-ui, sans-serif;
    font-size: clamp(17px, 2vw, 20px);
    font-weight: 700;
    text-decoration: none;
  }

  .dgs-sitemap-content a:hover {
    color: #1f4e8c;
  }

  .dgs-sitemap-content a span:last-child {
    color: #1f4e8c;
    font-size: 20px;
  }

  @media (max-width: 700px) {
    .dgs-sitemap-hero {
      padding-inline: 18px;
    }

    .dgs-sitemap-back {
      margin-bottom: 36px;
    }

    .dgs-sitemap-content {
      width: auto;
      margin-right: 16px;
      margin-left: 16px;
      padding: 28px 22px;
    }

    .dgs-sitemap-heading {
      align-items: start;
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
