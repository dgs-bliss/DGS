{
	// Cloudflare Workers configuration for the DGS Astro SSR application.
	// `nodejs_compat` exposes Node APIs required by Tina visual editing.
	"name": "dgs",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"upload_source_maps": true,
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	}
}
