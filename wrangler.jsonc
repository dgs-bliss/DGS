{
	// Cloudflare Workers configuration for the DGS Astro SSR application.
	// `nodejs_compat` exposes Node APIs required by Tina visual editing.
	"name": "dgs",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"upload_source_maps": true,
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	"previews": {
		"vars": {
			"CLOUDINARY_CLOUD_NAME": "ljjidst6",
			"CLOUDINARY_ROOT_FOLDER": "digitalgrowthsociety",
			"DEPLOY_ADAPTER": "cloudflare",
			"GITHUB_CONTENT_REPO": "dgs-bliss/DGS",
			"NEXT_PUBLIC_TINA_BRANCH": "staging",
			"NEXT_PUBLIC_TINA_CLIENT_ID": "256cd137-6a4b-4285-ab65-7bf0687aa753",
			"NEXT_PUBLIC_TINA_CONTENT_API_URL": "https://staging.digitalgrowthsociety.org/tina-content-proxy",
			"SITE_PROVISION_MODE": "same-site-migration",
			"SITE_URL": "https://staging.digitalgrowthsociety.org"
		},
		"kv_namespaces": [
			{
				"binding": "SESSION",
				"id": "6a14f497310f49a49c1967de9bea622b"
			}
		],
		"images": {
			"binding": "IMAGES"
		}
	}
}
